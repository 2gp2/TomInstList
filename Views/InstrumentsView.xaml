<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TomInstList.Views.InstrumentsView"
             Title="Instruments">

    <ScrollView>

        <VerticalStackLayout
            x:Name="InstrumentLayout"
            Padding="20"
            Spacing="15">

            <Label Text="Instrument List"
                   FontSize="30"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,0,0,20" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>